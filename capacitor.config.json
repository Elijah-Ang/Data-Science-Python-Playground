{
  "appId": "com.elijahang.datascienceplayground",
  "appName": "Data Science Playground",
  "webDir": "dist",
  "backgroundColor": "#0c1125",
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scrollEnabled": true,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0c1125",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#efe8d7",
      "overlaysWebView": false
    }
  }
}
